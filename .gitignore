# Generated results and caches for the separated analysis workflows
/RULE_CURVE_WORKSHOP/outputs/*
/DELAYED_DRAWDOWN_SCREENING/outputs/*
/ROUTING_RAMP_EVACUATION/outputs/*
!/RULE_CURVE_WORKSHOP/outputs/README.md
!/DELAYED_DRAWDOWN_SCREENING/outputs/README.md
!/ROUTING_RAMP_EVACUATION/outputs/README.md

# Keep directory documentation when external datasets are ignored
!/shared/temp_data/README.txt
!/shared/datasets_sharepoint/README.txt

# Do not ignore .md and .txt files anywhere in the repo
!**/*.md
!**/*.txt

# Preserve the historical snapshot, including formerly ignored directory notes
!/Archive/
!/Archive/**/
!/Archive/**/README.txt

# Optional FIRO debug exports are rebuilt on request, not committed results.
/FIRO_COMPONENTS/outputs/diagnostics/extra/
/FIRO_COMPONENTS/outputs/diagnostics/plots/
